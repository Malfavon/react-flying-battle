# ============================================================
# Minimalist Flight Simulator - Environment Variables
# ============================================================

# Frontend Configuration (Vite / Vercel)
# Set this to the production URL of your persistent Socket.io backend
# (e.g. Render, Railway, Fly.io).
# Leave empty or omitted in local development to default to localhost:3001.
VITE_SERVER_URL=https://your-flight-sim-server.onrender.com

# Backend Configuration (Node.js Server)
# Port is automatically assigned by cloud providers (Render/Railway/Heroku/Fly.io)
PORT=3001

# Allowed origins for CORS (comma-separated, or * for all)
CLIENT_ORIGIN=https://your-flight-sim.vercel.app,http://localhost:3000
